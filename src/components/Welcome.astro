---
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/starwind/card";
import background from '../assets/background.svg';
import Layout from "@/layouts/Layout.astro";

const baseUrl = import.meta.env.PUBLIC_BASE_URL;
---
<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<main>
		<section id="hero">
			<Card class="w-[360px]">
  <CardHeader>
    <CardTitle class="font-extrabold">Little Pi Status</CardTitle>
    <CardDescription>Your Backend API Status Running on your Little Pi</CardDescription>
  </CardHeader>
  <CardContent class="flex flex-col gap-4">
	<div>
		<h1 id="health-status" class="text-2xl italic font-bold">Loading status...</h1>
	</div>
  </CardContent>
</Card>
		</section>
	</main>

</div>



<script is:inline define:vars={{ baseUrl }}>
	const getData = async () => {
		const BASE_URL = baseUrl+ "/api/health";		
		try {
			const response = await fetch(BASE_URL, { method: "GET" });
			const res = await response.json();
			console.log(res);
			return res;
		} catch (e) {
			console.error(e);
			return { message: "Error Occurred" };
		}
	}
	
	// Execute the async function properly and update the UI
	getData().then((response) => {
		
		// Update the DOM with the health message
		const heading = document.getElementById('health-status');
		if (heading) {
			heading.textContent = response.message;
		}
	});

	setInterval(async()=> {
		const heading = document.getElementById('health-status');
		if (heading) {
			heading.textContent = 'Loading status...';
		}
		await getData().then((response) => {
		
		// Update the DOM with the health message
		const heading = document.getElementById('health-status');
		if (heading) {
			heading.textContent = response.message;
		}
	});
	},10000)
</script>


<style>
	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		height: 100%;
	}

	main {
		height: 100%;
		display: flex;
		justify-content: center;
	}

	#hero {
		display: flex;
		align-items: start;
		flex-direction: column;
		justify-content: center;
		padding: 16px;
	}

	@media screen and (max-width: 768px) {
		#container {
			display: flex;
			flex-direction: column;
		}

		#hero {
			display: block;
			padding-top: 10%;
		}
	}
</style>
